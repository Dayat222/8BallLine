<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Mini Draggable Bubble (ringkas agar tidak menghalangi area game) -->
    <LinearLayout
        android:id="@+id/layoutBubble"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_bubble"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ball8" />
    </LinearLayout>

    <!-- Expanded Floating Control Panel (kompak) -->
    <ScrollView
        android:id="@+id/layoutExpandedPanel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_card"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8BallLine"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnMinimize"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_secondary" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="@color/surface_card_border" />

            <!-- Toggle Garis Pantul -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Garis Pantul"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchLines"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:scaleX="0.82"
                    android:scaleY="0.82" />
            </LinearLayout>

            <!-- Toggle Titik Tengah (Half Diamonds) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Garis Tengah (0.5)"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHalfDiamonds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:scaleX="0.82"
                    android:scaleY="0.82" />
            </LinearLayout>

            <!-- Mode Kalibrasi vs Lock -->
            <Button
                android:id="@+id/btnToggleCalibration"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/accent_red"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Mode Kalibrasi"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <!-- Reset Posisi Meja ke Tengah Layar -->
            <Button
                android:id="@+id/btnResetTableInOverlay"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/surface_card"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Reset Posisi Meja"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp" />

            <!-- Arah Pantulan Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Arah Pantul:"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_floating_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/btnPrevDirection"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedDirection"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Semua Arah"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNextDirection"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Target Pocket Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Target Lubang:"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_floating_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/btnPrevPocket"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedPocket"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Semua Lubang"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNextPocket"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Opacity Slider -->
            <TextView
                android:id="@+id/tvOpacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Opasitas (80%)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seekBarOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:max="255"
                android:progress="210" />

            <!-- Close / Stop Service -->
            <Button
                android:id="@+id/btnCloseOverlay"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/surface_card_border"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Tutup Overlay"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
