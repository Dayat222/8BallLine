<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Mini Draggable Bubble (ringkas agar tidak menghalangi area game) -->
    <LinearLayout
        android:id="@+id/layoutBubble"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_bubble"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ball8" />
    </LinearLayout>

    <!-- Expanded Floating Control Panel (kompak + 1-tap quick filter) -->
    <ScrollView
        android:id="@+id/layoutExpandedPanel"
        android:layout_width="224dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_card"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8BallLine"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnMinimize"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_secondary" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="5dp"
                android:background="@color/surface_card_border" />

            <!-- Toggle Garis Pantul -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Garis Pantul"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchLines"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:scaleX="0.82"
                    android:scaleY="0.82" />
            </LinearLayout>

            <!-- Toggle Garis Titik Tengah (Half Diamonds) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Garis Tengah (0.5)"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHalfDiamonds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:scaleX="0.82"
                    android:scaleY="0.82" />
            </LinearLayout>

            <!-- Toggle Warna per Lubang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Warna per Lubang"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchColorByPocket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:scaleX="0.82"
                    android:scaleY="0.82" />
            </LinearLayout>

            <!-- 1-Tap Quick Pocket Filter Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Fokus Lubang (1-Tap):"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPocketTL"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↖ K.Atas"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPocketML"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● T.Atas"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPocketTR"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↗ Kn.Atas"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPocketBL"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↙ K.Bawah"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPocketMR"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● T.Bawah"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPocketBR"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↘ Kn.Bawah"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPocketAll"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="✦ Semua Lubang"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- 1-Tap Quick Direction Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Arah Pantul:"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDirAll"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="✛ Semua"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDirTB"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↕ Atas/Bwh"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDirLR"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↔ Kiri/Knn"
                    android:textColor="@color/text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Opacity Slider -->
            <TextView
                android:id="@+id/tvOpacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kecerahan / Opasitas (94%)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seekBarOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:max="255"
                android:progress="240" />

            <!-- Line Width Slider -->
            <TextView
                android:id="@+id/tvLineWidthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ketebalan Garis (2.6px)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seekBarLineWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:max="50"
                android:progress="16" />

            <!-- Warna Garis Tunggal (In-Game Color Picker) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pilih 1 Warna:"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/btnFloatColorCyan"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#00E5FF" />

                <View
                    android:id="@+id/btnFloatColorGreen"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#10B981" />

                <View
                    android:id="@+id/btnFloatColorYellow"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#F59E0B" />

                <View
                    android:id="@+id/btnFloatColorRed"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#EF4444" />

                <View
                    android:id="@+id/btnFloatColorWhite"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#FFFFFF" />

                <View
                    android:id="@+id/btnFloatColorBlack"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="1"
                    android:background="#111827" />
            </LinearLayout>

            <!-- Mode Kalibrasi & Reset -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggleCalibration"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1.2"
                    android:backgroundTint="@color/accent_red"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Kalibrasi"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnResetTableInOverlay"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_card"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Reset Meja"
                    android:textAllCaps="false"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Close / Stop Service -->
            <Button
                android:id="@+id/btnCloseOverlay"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/surface_card_border"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Tutup Overlay"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
